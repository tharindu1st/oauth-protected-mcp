# HTTP port the MCP server listens on
PORT=3000

# Log verbosity: error|warn|info|debug (default: info). Debug logs include
# per-request auth decisions and tool-call details — verbose, dev/debug use.
LOG_LEVEL=info

# Shorthand: set to "true" to force debug-level logging regardless of LOG_LEVEL.
DEBUG=

# Public base URL of this MCP server (used for OAuth Protected Resource Metadata
# and, optionally, audience validation). e.g. http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000

# --- Identity Provider (IdP) configuration -----------------------------------
# Any standard OIDC-compliant IdP works here (WSO2 Identity Server, Asgardeo,
# Auth0, Keycloak, Okta, etc). Only the issuer is strictly required; the JWKS
# endpoint is auto-discovered from the issuer's /.well-known/openid-configuration
# unless OAUTH_JWKS_URI is set explicitly.

# Issuer URL of the IdP that mints access tokens for this MCP server
OAUTH_ISSUER=https://localhost:9443/oauth2/token

# (Optional) Explicit JWKS URI. If unset, discovered from
# ${OAUTH_ISSUER}/.well-known/openid-configuration
OAUTH_JWKS_URI=

# (Optional) Expected audience ("aud") claim on the access token. Leave empty
# to skip audience validation.
OAUTH_AUDIENCE=

# JWT claim used to identify the user for data filtering (falls back to "sub"
# if the claim is missing on the token)
OAUTH_USER_CLAIM=email

# (Optional) Space-separated list of scopes required to call MCP tools.
# Leave empty to skip scope enforcement.
OAUTH_REQUIRED_SCOPES=

# (Optional) Space-separated list of scopes advertised via `scopes_supported`
# in this server's OAuth Protected Resource Metadata (RFC 9728). MCP clients
# that honor this field request only these scopes. Defaults to
# "openid profile email offline_access" if unset. Do NOT include Okta's
# `device_sso` and `interclient_access` system scopes together here — Okta
# rejects requesting both in the same authorization request.
OAUTH_SCOPES_SUPPORTED=

# (Optional, dev/test only) Force every validated token to be treated as this
# user for data filtering, regardless of its claims. Useful for exercising
# per-user filtering with tokens that carry no per-user identity (e.g. an
# Asgardeo client-credentials/application token). The token must still be
# valid and signed by the configured IdP. Never set this for real users.
OAUTH_OVERRIDE_USER_KEY=
